# Copy to .env for local overrides. Railway reads the same names as service
# variables - do not commit real values anywhere.

# Core
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres on Railway; leave unset to use the local db.sqlite3
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Storefront origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare R2 (product imagery).
# Media falls back to the local media/ directory until all four of
# R2_BUCKET / R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are set.
# R2_BUCKET=maison-media
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Public hostname the browser fetches images from: either the bucket's
# r2.dev subdomain or a custom domain you attach in Cloudflare.
# R2_PUBLIC_DOMAIN=cdn.yourdomain.com

# SMTP (optional - nothing sends mail yet)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Contact form notification recipient. Empty = no notification is attempted
# (the message is still saved). Mail goes to the console unless EMAIL_HOST is set.
# CONTACT_NOTIFY_EMAIL=hello@yourdomain.com
